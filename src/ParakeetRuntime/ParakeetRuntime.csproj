<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ParakeetRuntime</PackageId>
    <Description>Speech-to-text for NVIDIA Parakeet TDT models in GGUF format, written in C#: int8 CPU kernels and a Direct3D 12 GPU path. Runs offline on Windows.</Description>
    <PackageTags>parakeet;speech-recognition;speech-to-text;asr;gguf;nvidia;nemo;offline;direct3d12</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kkolodziejczak/ParakeetRuntime.Net</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct3D 12 and the engine's Win32 calls exist only on Windows; the analyzer warns callers elsewhere. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
    <InternalsVisibleTo Include="ParakeetRuntime.Tests" />
    <InternalsVisibleTo Include="parakeet-runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
