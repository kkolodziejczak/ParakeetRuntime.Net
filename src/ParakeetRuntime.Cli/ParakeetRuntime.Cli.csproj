<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Not "ParakeetRuntime": the exe's own assembly would collide with the library's ParakeetRuntime.dll. -->
    <AssemblyName>parakeet-runtime</AssemblyName>
    <RootNamespace>ParakeetRuntime.Cli</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ParakeetRuntime\ParakeetRuntime.csproj" />
  </ItemGroup>

</Project>
